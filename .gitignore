# Unity .gitignore
# Based on https://github.com/github/gitignore/blob/main/Unity.gitignore
# Place this file at the root of your Unity project directory (next to Assets/ and ProjectSettings/)

# ---- Unity generated folders ----
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/.utmp/
/WorkSpace/

# ---- Asset meta data ----
# Ignore .meta only when the corresponding asset is ignored too
!/[Aa]ssets/**/*.meta

# Uncomment to ignore the Asset Store tools plugin
# /[Aa]ssets/AssetStoreTools*

# ---- JetBrains Rider / IDE ----
/[Aa]ssets/Plugins/Editor/JetBrains*
.idea/
.vs/
.vscode/
.consulo/
ExportedObj/

# ---- Autogenerated VS / MD / solution & project files ----
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---- Unity3D generated meta files ----
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ---- Unity3D crash report info ----
sysinfo.txt

# ---- Builds / artifacts ----
*.aab
*.unitypackage
*.app
[Bb]uilds/

# ---- Android / Gradle ----
.gradle/
/[Aa]ssets/Plugins/[Aa]ndroid/**.jar
!/[Aa]ssets/Plugins/[Aa]ndroid/**/*.aar.meta

# ---- Crashlytics generated file ----
crashlytics-build.properties

# ---- Packed Addressables ----
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# ---- Temporary auto-generated Android Assets ----
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---- Secrets / local SDK configs (uncomment what your project needs) ----
# google-services.json
# GoogleService-Info.plist
# .env
# /[Aa]ssets/StreamingAssets/google-services.json
